---

<section class="s-contact">
  <div class="s-contact__container">
    <form class="s-contact__form" action="https://formspree.io/f/xpqyzzvg" method="POST">
      <div class="s-contact__form-field">
        <label class="s-contact__form-label" for="name">Nombre</label>
        <input class="s-contact__form-input" id="name" name="name" type="text" required />
      </div>

      <div class="s-contact__form-field">
        <label class="s-contact__form-label" for="email">Email</label>
        <input class="s-contact__form-input" id="email" name="email" type="email" required />
      </div>

      <div class="s-contact__form-field">
        <label class="s-contact__form-label" for="message">Mensaje</label>
        <textarea class="s-contact__form-textarea" id="message" name="message" rows="4" required></textarea>
      </div>

      <button class="s-contact__form-submit" type="submit">Enviar</button>
    </form>
  </div>
</section>
