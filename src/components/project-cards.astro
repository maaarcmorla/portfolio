---
import testImg from '../assets/pexels-apasaric-1527934.jpg';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const projects = [
  {
    title: "Fitness App",
    description: "Aplicación de seguimiento de entrenamientos y hábitos saludables.",
    img: testImg.src,
    alt: "Captura de Fitness App",
  },
  {
    title: "Portfolio",
    description: "Portfolio personal desarrollado con Astro y SCSS.",
    img: testImg.src,
    alt: "Captura de Portfolio",
  },
];

const visibleProjects = limit ? projects.slice(0, limit) : projects;
---

<section class="s-project-cards">
  <div class="s-project-cards__container">
    {limit && <h2 class="s-project-cards__title">Proyectos</h2>}
    <div class="s-project-cards__grid">
      {visibleProjects.map((project) => (
        <div class="c-portfolio-card">
          <div class="c-portfolio-card__img">
            <img src={project.img} alt={project.alt} />
          </div>
          <div class="c-portfolio-card__content">
            <h3 class="c-portfolio-card__content--title">{project.title}</h3>
            <p class="c-portfolio-card__content--text">{project.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>