---
import testImg from '../assets/pexels-apasaric-1527934.jpg';
---

<section class="s-header">
  <div class="s-header__container">
    <a class="s-header__logo" href="/portfolio/">
      <img src={testImg.src} alt="logo">
    </a>
    <input type="checkbox" id="nav-toggle" class="s-header__toggle-input" aria-hidden="true">
    <label for="nav-toggle" class="s-header__toggle" aria-label="Abrir menú">
      <span class="s-header__toggle-icon"></span>
    </label>
    <nav class="s-header__list">
      <a class="s-header__list-text" href="/portfolio/proyects">Proyectos</a>
      <a class="s-header__list-text" href="/portfolio/about">Sobre mi</a>
      <a class="s-header__list-text" href="/portfolio/contact">Contacto</a>
    </nav>
  </div>
</section>